# Copy this file to backend/.env and adjust as needed.
# Every value below is optional — these are the defaults.

# Express API
PORT=5000

# llama.cpp chat server (LLM)
LLAMA_CHAT_HOST=localhost
LLAMA_CHAT_PORT=8080

# llama.cpp embedding server (required for Document/RAG mode)
LLAMA_EMBED_HOST=localhost
LLAMA_EMBED_PORT=8081
EMBED_MODEL=mxbai-embed-large
EMBED_CONCURRENCY=4

# RAG tuning
CHUNK_SIZE=700
CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
RAG_MAX_CONTEXT=6000

# Model files used by scripts/start-llama.sh
CHAT_MODEL_PATH=./models/Qwen3-8B-Q4_K_M.gguf
EMBED_MODEL_PATH=./models/mxbai-embed-large-v1.Q4_0.gguf

# Speech-to-text (whisper.cpp). Defaults to ./whisper.cpp at the project root.
# WHISPER_CLI_PATH=/path/to/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL_PATH=/path/to/whisper.cpp/models/ggml-base.en.bin

# Log every streamed token (slow — debugging only)
# DEBUG_TOKENS=1
